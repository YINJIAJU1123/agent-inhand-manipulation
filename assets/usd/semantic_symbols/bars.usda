#usda 1.0
(defaultPrim = "Symbol"
 metersPerUnit = 1
 upAxis = "Z")
def Xform "Symbol" {
    def Material "White" {
        token outputs:surface.connect = </Symbol/White/Shader.outputs:surface>
        def Shader "Shader" {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (1, 1, 1)
            float inputs:roughness = 1
            token outputs:surface
        }
    }
    def Material "Black" {
        token outputs:surface.connect = </Symbol/Black/Shader.outputs:surface>
        def Shader "Shader" {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.01, 0.01, 0.01)
            float inputs:roughness = 1
            token outputs:surface
        }
    }
    def Mesh "Outline" (prepend apiSchemas = ["MaterialBindingAPI"]) {
        point3f[] points = [(-0.007649999999999999, -0.00585, 0), (0.007649999999999999, -0.00585, 0), (0.007649999999999999, -0.0018, 0), (-0.007649999999999999, -0.0018, 0), (0.0, -0.0038249999999999994, 0), (-0.007649999999999999, 0.0018, 0), (0.007649999999999999, 0.0018, 0), (0.007649999999999999, 0.00585, 0), (-0.007649999999999999, 0.00585, 0), (0.0, 0.0038250000000000003, 0)]
        int[] faceVertexCounts = [3, 3, 3, 3, 3, 3, 3, 3]
        int[] faceVertexIndices = [4, 0, 1, 4, 1, 2, 4, 2, 3, 4, 3, 0, 9, 5, 6, 9, 6, 7, 9, 7, 8, 9, 8, 5]
        uniform token subdivisionScheme = "none"
        bool doubleSided = true
        rel material:binding = </Symbol/White>
    }
    def Mesh "Ink" (prepend apiSchemas = ["MaterialBindingAPI"]) {
        point3f[] points = [(-0.006375, -0.004875, 0.00012), (0.006375, -0.004875, 0.00012), (0.006375, -0.0015, 0.00012), (-0.006375, -0.0015, 0.00012), (0.0, -0.0031875, 0.00012), (-0.006375, 0.0015, 0.00012), (0.006375, 0.0015, 0.00012), (0.006375, 0.004875, 0.00012), (-0.006375, 0.004875, 0.00012), (0.0, 0.0031875000000000002, 0.00012)]
        int[] faceVertexCounts = [3, 3, 3, 3, 3, 3, 3, 3]
        int[] faceVertexIndices = [4, 0, 1, 4, 1, 2, 4, 2, 3, 4, 3, 0, 9, 5, 6, 9, 6, 7, 9, 7, 8, 9, 8, 5]
        uniform token subdivisionScheme = "none"
        bool doubleSided = true
        rel material:binding = </Symbol/Black>
