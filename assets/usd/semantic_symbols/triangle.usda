#usda 1.0
(defaultPrim = "Symbol"
 metersPerUnit = 1
 upAxis = "Z")
def Xform "Symbol" {
    def Material "White" {
        token outputs:surface.connect = </Symbol/White/Shader.outputs:surface>
        def Shader "Shader" {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (1, 1, 1)
            float inputs:roughness = 1
            token outputs:surface
        }
    }
    def Material "Black" {
        token outputs:surface.connect = </Symbol/Black/Shader.outputs:surface>
        def Shader "Shader" {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.01, 0.01, 0.01)
            float inputs:roughness = 1
            token outputs:surface
        }
    }
    def Mesh "Outline" (prepend apiSchemas = ["MaterialBindingAPI"]) {
        point3f[] points = [(0.0, 0.009, 0), (-0.0081, -0.006299999999999999, 0), (0.0081, -0.006299999999999999, 0), (0.0, -0.0011999999999999997, 0)]
        int[] faceVertexCounts = [3, 3, 3]
        int[] faceVertexIndices = [3, 0, 1, 3, 1, 2, 3, 2, 0]
        uniform token subdivisionScheme = "none"
        bool doubleSided = true
        rel material:binding = </Symbol/White>
    }
    def Mesh "Ink" (prepend apiSchemas = ["MaterialBindingAPI"]) {
        point3f[] points = [(0.0, 0.0075, 0.00012), (-0.00675, -0.0052499999999999995, 0.00012), (0.00675, -0.0052499999999999995, 0.00012), (0.0, -0.0009999999999999998, 0.00012)]
        int[] faceVertexCounts = [3, 3, 3]
        int[] faceVertexIndices = [3, 0, 1, 3, 1, 2, 3, 2, 0]
        uniform token subdivisionScheme = "none"
        bool doubleSided = true
        rel material:binding = </Symbol/Black>
    }
}
